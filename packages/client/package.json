{
  "name": "@opentunnel/client",
  "version": "0.2.2",
  "description": "OpenTunnel SDK for Bun: expose local services through a blind TLS tunnel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opentunnel.git",
    "directory": "packages/client"
  },
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/promise/index.d.ts",
      "bun": "./src/promise/index.ts",
      "default": "./dist/promise/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "bun": "./src/promise/index.ts",
      "default": "./dist/promise/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "bun": "./src/effect/index.ts",
      "default": "./dist/effect/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opentunnel/protocol": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@peculiar/x509": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  }
}
