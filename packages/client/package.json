{
  "name": "@opentunnel/client",
  "version": "0.5.0",
  "description": "OpenTunnel SDK for Bun: expose local services through a blind TLS tunnel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opentunnel.git",
    "directory": "packages/client"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/promise/index.d.ts",
      "default": "./dist/promise/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "default": "./dist/promise/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "default": "./dist/effect/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opentunnel/protocol": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@peculiar/x509": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  }
}
