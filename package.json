{
  "name": "opentunnel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --cwd packages/server run dev",
    "deploy": "bun --cwd packages/server run deploy",
    "cf-typegen": "bun --cwd packages/server run cf-typegen",
    "opentunnel": "bun packages/cli/src/index.ts",
    "ready": "bun run --filter '*' build"
  },
  "workspaces": {
    "packages": ["apps/*", "packages/*", "tools/*"],
    "catalog": {
      "@effect/platform-node": "4.0.0-beta.42",
      "@peculiar/acme-client": "1.8.2",
      "@peculiar/jose": "1.8.2",
      "@peculiar/x509": "2.0.0",
      "@types/bun": "1.3.13",
      "@types/node": "25.5.0",
      "@types/ws": "8.18.1",
      "@typescript/native-preview": "7.0.0-dev.20260328.1",
      "bumpp": "11.0.1",
      "effect": "4.0.0-beta.42",
      "reflect-metadata": "0.2.2",
      "smol-toml": "1.7.1",
      "typescript": "6.0.2",
      "wrangler": "4.120.0",
      "ws": "8.20.0"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.42"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
