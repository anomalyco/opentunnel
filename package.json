{
  "name": "@opentunnel/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --cwd packages/server run dev",
    "deploy": "bun --cwd packages/server run deploy",
    "cf-typegen": "bun --cwd packages/server run cf-typegen",
    "opentunnel": "cargo run -q -p opentunnel-cli --",
    "ready": "bun run --filter '*' build",
    "changeset": "changeset",
    "release": "bun --cwd packages/cli run publish && bun packages/client/script/publish.ts && bun packages/cli/script/release.ts",
    "test": "cargo test --workspace && bun run --filter '*' test"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@peculiar/acme-client": "1.8.2",
      "@peculiar/jose": "1.8.2",
      "@peculiar/x509": "2.0.0",
      "@types/bun": "1.3.13",
      "@types/node": "25.5.0",
      "@typescript/native-preview": "7.0.0-dev.20260328.1",
      "bumpp": "11.0.1",
      "effect": "4.0.0-beta.42",
      "reflect-metadata": "0.2.2",
      "typescript": "6.0.2",
      "wrangler": "4.120.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
