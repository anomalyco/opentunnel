{
  "name": "@opentunnel/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "cf deploy --prebuilt",
    "types": "cf workers types",
    "ready": "cf workers types && bun run --filter '*' build && vite build",
    "opentunnel": "cargo run -q -p opentunnel-cli --",
    "changeset": "changeset",
    "version": "changeset version && bun packages/cli/script/version.ts",
    "release": "bun packages/cli/script/publish.ts && bun packages/client/script/publish.ts && bun packages/cli/script/crates.ts && bun packages/cli/script/release.ts",
    "test": "cargo test --workspace && bun run --filter '*' test"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
      "@peculiar/acme-client": "1.8.2",
      "@peculiar/jose": "1.8.2",
      "@peculiar/x509": "2.0.0",
      "@types/bun": "1.3.13",
      "@types/node": "25.5.0",
      "@typescript/native-preview": "7.0.0-dev.20260328.1",
      "bumpp": "11.0.1",
      "cf": "1.0.0-beta.13",
      "effect": "4.0.0-beta.42",
      "reflect-metadata": "0.2.2",
      "typescript": "6.0.2"
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@cloudflare/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "6.0.3",
    "cf": "catalog:",
    "vite": "8.1.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
